{
  "name": "toweriq-backend",
  "version": "2.0.0",
  "description": "TowerIQ: load-shedding-aware tower monitoring & resilience intelligence. Zero runtime dependencies (Node.js built-ins only).",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "demo:reset": "node scripts/reset-demo.js",
    "create-admin": "node --experimental-sqlite scripts/create-admin.js",
    "test": "node --experimental-sqlite --test --test-force-exit --test-concurrency=1 tests/"
  },
  "dependencies": {},
  "devDependencies": {},
  "license": "MIT"
}
