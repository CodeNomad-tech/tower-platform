# TowerIQ backend configuration. All values have safe local-demo defaults.
# Export these as environment variables (no dotenv loader is bundled).

PORT=3000                 # HTTP (console + API + WebSocket)
MQTT_PORT=1883            # embedded MQTT broker for devices
DB_PATH=./data/toweriq.db # SQLite file

# Demo mode: seeds 12 SIMULATED sites + 30 days of simulated history, runs the
# fleet simulator and enables admin scenario controls. Set false for real use.
DEMO_MODE=true
RUN_SIMULATOR=true
HISTORY_DAYS=30
SIM_TICK_MS=10000

# Demo users (admin/operator/viewer@toweriq.demo) share this password.
DEMO_ADMIN_PASSWORD=ChangeMe123!
